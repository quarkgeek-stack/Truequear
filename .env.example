# URL de conexión a la base de datos PostgreSQL (cuentas, avisos, chats, tratos y fotos sin S3)
DATABASE_URL="postgresql://postgres:password@localhost:5432/truequear?schema=public"

# Secreto para firmar las sesiones de Auth.js (generar con: openssl rand -base64 32)
AUTH_SECRET=""

# URL base de autenticación para Auth.js (ej: http://localhost:3000)
AUTH_URL=""

# Client ID de Google OAuth (si está vacío junto con AUTH_GOOGLE_SECRET, el botón de Google no se muestra)
AUTH_GOOGLE_ID=""

# Client Secret de Google OAuth
AUTH_GOOGLE_SECRET=""

# Lista de emails separados por coma que reciben el rol ADMIN al registrarse o ingresar
ADMIN_EMAILS=""

# URL base pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Access Token de MercadoPago Checkout Pro (si está vacío, no se muestra botón de cobro de comisión hasta configurarlo)
MERCADOPAGO_ACCESS_TOKEN=""

# Nombre del bucket S3 o Cloudflare R2 para subir fotos (si falta, guarda data URL comprimida en Postgres)
S3_BUCKET=""

# Access Key ID del almacenamiento compatible con S3
S3_ACCESS_KEY_ID=""

# Secret Access Key del almacenamiento compatible con S3
S3_SECRET_ACCESS_KEY=""

# Endpoint de S3 o Cloudflare R2 (ej: https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=""

# URL pública base para construir los links de imágenes subidas a S3/R2
S3_PUBLIC_URL=""

# Opcional para app Android / Play Store (TWA): nombre de paquete (ej: ar.trueque.app)
ANDROID_PACKAGE_NAME=""

# Opcional para app Android / Play Store (TWA): huella SHA-256 del keystore de firma
ANDROID_SHA256_FINGERPRINT=""
